{
    "$schema": "node_modules/wrangler/config-schema.json",
    "main": ".open-next/worker.js",
    "name": "tw-payload-staging",
    "compatibility_date": "2025-08-15",
    "compatibility_flags": [
        // Enable Node.js API
        // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#nodejs-compatibility-flag
        "nodejs_compat",
        // Allow to fetch URLs in your app
        // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#global-fetch-strictly-public
        "global_fetch_strictly_public"
    ],
    "placement": {
        "mode": "smart"
    },
    "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
    },
    "d1_databases": [
        {
            "binding": "D1",
            "database_id": "28ee8f28-a8b4-4b60-9874-3835aeb281b9",
            "database_name": "tw-payload-development",
            "remote": true
        }
    ],
    "r2_buckets": [
        {
            "binding": "R2",
            "bucket_name": "tw-payload-development",
            "preview_bucket_name": "tw-payload-development"
        }
    ],
    "env": {
        "development": {
            "name": "tw-payload-development",
            "d1_databases": [
                {
                    "binding": "D1",
                    "database_id": "28ee8f28-a8b4-4b60-9874-3835aeb281b9",
                    "database_name": "tw-payload-development",
                    "remote": true
                }
            ],
            "r2_buckets": [
                {
                    "binding": "R2",
                    "bucket_name": "tw-payload-development",
                    "preview_bucket_name": "tw-payload-development"
                }
            ]
        },
        "staging": {
            "name": "tw-payload-staging",
            "d1_databases": [
                {
                    "binding": "D1",
                    "database_id": "1fc89e0f-2f48-4812-b16e-70e4aa7cd855",
                    "database_name": "tw-payload-staging",
                    "remote": true
                }
            ],
            "r2_buckets": [
                {
                    "binding": "R2",
                    "bucket_name": "tw-payload-staging",
                    "preview_bucket_name": "tw-payload-staging"
                }
            ]
        },
        "production": {
            "name": "tw-payload-production",
            "d1_databases": [
                {
                    "binding": "D1",
                    "database_id": "86d4fb27-31bc-4444-8ad0-2d332a6a4993",
                    "database_name": "tw-payload-production",
                    "remote": true
                }
            ],
            "r2_buckets": [
                {
                    "binding": "R2",
                    "bucket_name": "tw-payload-production",
                    "preview_bucket_name": "tw-payload-production"
                }
            ]
        }
    }
}
